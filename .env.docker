# Environment variables for Docker deployment

# Database
DATABASE_URL="postgresql://agent:agent@postgres:5432/agent_db"

# Redis (for Task Queue)
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"

# Server configuration
HOST="0.0.0.0"
PORT="8000"
DEBUG="true"

# Security/Safety
ALLOWED_ROOT="/workspace"  # Root directory for filesystem operations

# LLM Configuration
LLM_PROVIDER="openai"      # openai, gemini, or deepseek
MODEL_NAME="gpt-4o-mini"   # Default model

# Budget limits
MAX_TOKENS_PER_TASK="4000" # Default max tokens per task
MAX_STEPS_PER_TASK="10"    # Default max steps per task